{
  "name": "netlify-fullstack",
  "description": "Fullstack typescript application template for deployment to Netlify",
  "author": {
    "email": "ferdiebergado@gmail.com",
    "name": "Ferdinand Saporas Bergado"
  },
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "db:create": "sqlite3 local.db < ./init.sql",
    "db:seed": "sqlite3 local.db < ./seed.sql",
    "db": "sqlite3 -init .sqliterc local.db",
    "db:reset": "read -p 'Are you sure you want to reset the DB? (y/n) ' res && [ \"$res\" = \"y\" ] && rm -f local.db && npm run db:create && npm run db:seed",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/oxanium": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@hookform/resolvers": "5.5.7",
    "@libsql/client": "0.17.4",
    "@netlify/edge-functions": "3.0.8",
    "@netlify/functions": "5.3.0",
    "@node-projects/excelforge": "3.6.0",
    "@remixicon/react": "4.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@zip.js/zip.js": "2.8.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "easy-template-x": "^7.2.6",
    "fast-xml-builder": "1.3.0",
    "fast-xml-parser": "5.10.1",
    "google-auth-library": "11.0.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.2",
    "react-hook-form": "7.83.0",
    "react-router": "8.3.0",
    "shadcn": "4.16.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "to-words": "5.6.1",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/node22": "22.0.5",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "globals": "17.8.0",
    "netlify-cli": "27.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
